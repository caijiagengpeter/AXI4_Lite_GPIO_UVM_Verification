    {
      "id": "gpio_c3_3_nin0_seed36", "set": "c3_3", "merge_group": "gpio_nin0",
      "test_name": "axi4l_c3_3_parameter_test", "target": "parameter_nin0", "seed": 36,
      "execution_target": "GPIO DUT RTL", "build_variant": "tb_top_nin0_nout32", "config": "nin0_nout32_skid1_lowpower0",
      "coverage_object": "gpio_dut_nin0_nout32_skid1_lowpower0", "driver_mode": "legacy_serial_checked", "runtime_parameters": {"upper_words_alias_output_ops": true},
      "expected_outcome": {"kind": "clean_uvm", "required_markers": ["[C3_3_PARAMETER_PASS]"]}, "plusargs": []
