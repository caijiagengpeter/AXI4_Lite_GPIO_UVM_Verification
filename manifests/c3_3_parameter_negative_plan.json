    {
      "id": "gpio_c3_3_skid0_seed34", "set": "c3_3", "merge_group": "gpio_skid0",
      "test_name": "axi4l_c3_3_parameter_test", "target": "parameter_skid0", "seed": 34,
      "execution_target": "GPIO DUT RTL", "build_variant": "tb_top_skid0", "config": "nin5_nout30_skid0_lowpower0",
      "coverage_object": "gpio_dut_nin5_nout30_skid0_lowpower0", "driver_mode": "legacy_serial_checked", "runtime_parameters": {},
      "expected_outcome": {"kind": "clean_uvm", "required_markers": ["[C3_3_PARAMETER_PASS]"]}, "plusargs": []
    },
    {
      "id": "gpio_c3_3_lowpower1_seed35", "set": "c3_3", "merge_group": "gpio_lowpower1",
      "test_name": "axi4l_c3_3_parameter_test", "target": "parameter_lowpower1", "seed": 35,
      "execution_target": "GPIO DUT RTL", "build_variant": "tb_top_lowpower1", "config": "nin5_nout30_skid1_lowpower1",
      "coverage_object": "gpio_dut_nin5_nout30_skid1_lowpower1", "driver_mode": "legacy_serial_checked", "runtime_parameters": {},
      "expected_outcome": {"kind": "clean_uvm", "required_markers": ["[C3_3_PARAMETER_PASS]"]}, "plusargs": []
