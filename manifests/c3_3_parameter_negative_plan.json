      "test_name": "axi4l_c3_3_parameter_test", "target": "parameter_min_positive", "seed": 33,
      "execution_target": "GPIO DUT RTL", "build_variant": "tb_top_nin1_nout1", "config": "nin1_nout1_skid1_lowpower0",
      "coverage_object": "gpio_dut_nin1_nout1_skid1_lowpower0", "driver_mode": "legacy_serial_checked", "runtime_parameters": {},
      "expected_outcome": {"kind": "clean_uvm", "required_markers": ["[C3_3_PARAMETER_PASS]"]}, "plusargs": []
